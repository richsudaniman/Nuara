{
  "name": "User",
  "type": "object",
  "properties": {
    "assigned_trainer_id": {
      "type": "string",
      "description": "ID of the practitioner assigned to this patient"
    },
    "user_type": {
      "type": "string",
      "enum": [
        "client",
        "trainer"
      ],
      "default": "client",
      "description": "Type of user - client or trainer"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "bio": {
      "type": "string",
      "description": "User biography or description"
    },
    "specialties": {
      "type": "string",
      "description": "Trainer specialties (for trainers only)"
    },
    "profile_photo_url": {
      "type": "string",
      "description": "URL to profile photo"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "Patient date of birth"
    },
    "age": {
      "type": "number",
      "description": "Patient age"
    },
    "diagnosis": {
      "type": "string",
      "description": "Clinical diagnosis (e.g. Articulation disorder \u00b7 /r/ and /s/)"
    },
    "therapy_focus": {
      "type": "string",
      "description": "Primary area of therapy focus (e.g. Articulation, Fluency, Language)"
    },
    "session_schedule": {
      "type": "string",
      "description": "Session schedule description (e.g. 2\u00d7 / week, Tue + Fri)"
    },
    "parent_guardian_name": {
      "type": "string",
      "description": "Name of parent or guardian"
    },
    "daily_calorie_target": {
      "type": "number",
      "description": "Daily calorie target"
    },
    "daily_protein_target": {
      "type": "number",
      "description": "Daily protein target in grams"
    }
  },
  "required": []
}