{
  "name": "TherapyLog",
  "type": "object",
  "properties": {
    "logged_by_client_id": {
      "type": "string",
      "description": "ID of the patient who logged this"
    },
    "workout_plan_id": {
      "type": "string",
      "description": "Reference to TherapyPlan"
    },
    "exercise_name": {
      "type": "string",
      "description": "Name of the task"
    },
    "completed_date": {
      "type": "string",
      "format": "date",
      "description": "Date when completed"
    },
    "sets_completed": {
      "type": "integer",
      "description": "Number of sets completed"
    },
    "weight_used": {
      "type": "number",
      "description": "Legacy numeric field (unused for speech therapy)"
    },
    "reps_completed": {
      "type": "integer",
      "description": "Reps completed per set"
    },
    "modality": {
      "type": "string",
      "enum": [
        "audio",
        "photo",
        "video",
        "caregiver_note"
      ],
      "description": "Submission modality used"
    },
    "submission_url": {
      "type": "string",
      "description": "URL to the uploaded photo/video/audio submission (if any)"
    },
    "goal_id": {
      "type": "string",
      "description": "Reference to the TherapyGoal this submission advances (if linked)"
    },
    "metric_type": {
      "type": "string",
      "description": "Metric captured by this submission (e.g., articulation_accuracy, sentence_length, fluency_rate)"
    },
    "metric_value": {
      "type": "number",
      "description": "Measured metric value for this session (e.g., 85 for 85% accuracy)"
    },
    "session_label": {
      "type": "string",
      "description": "Optional human label for the session (e.g., Session 3)"
    },
    "notes": {
      "type": "string",
      "description": "Caregiver note text or user notes"
    }
  },
  "required": [
    "exercise_name",
    "completed_date"
  ]
}