{
  "name": "ClinicalGoal",
  "type": "object",
  "properties": {
    "assigned_to_patient_id": {
      "type": "string",
      "description": "ID of the patient this goal is assigned to"
    },
    "created_by_chiropractor_id": {
      "type": "string",
      "description": "ID of the practitioner who created this goal"
    },
    "goal_title": {
      "type": "string",
      "description": "Goal title"
    },
    "target_value": {
      "type": "string",
      "description": "Target value"
    },
    "current_value": {
      "type": "string",
      "description": "Current value"
    },
    "target_date": {
      "type": "string",
      "format": "date",
      "description": "Target completion date"
    },
    "progress_percentage": {
      "type": "number",
      "description": "Progress percentage (0-100)"
    },
    "linked_metric_type": {
      "type": "string",
      "description": "The specific clinical metric type this goal tracks"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether goal is active"
    }
  },
  "required": [
    "goal_title",
    "target_value"
  ]
}