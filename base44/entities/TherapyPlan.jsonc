{
  "name": "TherapyPlan",
  "type": "object",
  "properties": {
    "assigned_to_client_id": {
      "type": "string",
      "description": "ID of the patient this plan is assigned to"
    },
    "created_by_trainer_id": {
      "type": "string",
      "description": "ID of the practitioner who created this plan"
    },
    "day_of_week": {
      "type": "string",
      "enum": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday"
      ],
      "description": "Day of the week"
    },
    "workout_type": {
      "type": "string",
      "description": "Type of therapy session (e.g., Articulation, Fluency, Target sounds: /p/ I)"
    },
    "homework_type": {
      "type": "string",
      "enum": [
        "articulation",
        "minimal_pairs",
        "fluency",
        "reading",
        "resource"
      ],
      "default": "articulation",
      "description": "Kind of homework this plan delivers"
    },
    "strategy_target": {
      "type": "string",
      "description": "Fluency/reading strategy focus, or the minimal-pairs contrast and error pattern"
    },
    "exercises": {
      "type": "array",
      "description": "List of therapy tasks for the day",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Task name, target word, minimal pair, or sentence to read"
          },
          "reps": {
            "type": "integer",
            "description": "Number of repetitions"
          },
          "sets": {
            "type": "integer",
            "description": "Number of sets"
          },
          "modality": {
            "type": "string",
            "enum": [
              "audio",
              "photo",
              "video",
              "caregiver_note"
            ],
            "default": "audio",
            "description": "Submission modality the patient must complete"
          },
          "activity_id": {
            "type": "string",
            "description": "Reference to a TherapyActivity library resource used as a template"
          },
          "goal_id": {
            "type": "string",
            "description": "Reference to the TherapyGoal this task is meant to advance"
          },
          "metric_type": {
            "type": "string",
            "description": "Metric this task produces (e.g., articulation_accuracy, contrast_accuracy, fluency_rate)"
          },
          "phoneme": {
            "type": "string",
            "description": "Target phoneme(s) in IPA (e.g., p, \u0283, sp, or p vs b for minimal pairs)"
          },
          "position": {
            "type": "string",
            "enum": [
              "initial",
              "medial",
              "final"
            ],
            "description": "Word position of the target phoneme"
          },
          "ipa": {
            "type": "string",
            "description": "IPA transcription of the target word or pair"
          },
          "video_url": {
            "type": "string",
            "description": "URL to demonstration video"
          },
          "notes": {
            "type": "string",
            "description": "Additional instructions"
          }
        }
      }
    },
    "order": {
      "type": "integer",
      "description": "Order in the week (1-7)"
    }
  },
  "required": [
    "day_of_week",
    "workout_type",
    "exercises",
    "order"
  ]
}