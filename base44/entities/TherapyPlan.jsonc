{
  "name": "TherapyPlan",
  "type": "object",
  "properties": {
    "assigned_to_client_id": {
      "type": "string",
      "description": "ID of the patient this plan is assigned to"
    },
    "created_by_trainer_id": {
      "type": "string",
      "description": "ID of the practitioner who created this plan"
    },
    "day_of_week": {
      "type": "string",
      "enum": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday"
      ],
      "description": "Day of the week"
    },
    "workout_type": {
      "type": "string",
      "description": "Type of therapy session (e.g., Articulation, Fluency, Language)"
    },
    "exercises": {
      "type": "array",
      "description": "List of therapy tasks for the day",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Task name"
          },
          "reps": {
            "type": "integer",
            "description": "Number of repetitions"
          },
          "sets": {
            "type": "integer",
            "description": "Number of sets"
          },
          "modality": {
            "type": "string",
            "enum": [
              "audio",
              "photo",
              "video",
              "caregiver_note"
            ],
            "default": "audio",
            "description": "Submission modality the patient must complete"
          },
          "activity_id": {
            "type": "string",
            "description": "Reference to a TherapyActivity library resource used as a template"
          },
          "goal_id": {
            "type": "string",
            "description": "Reference to the TherapyGoal this task is meant to advance"
          },
          "metric_type": {
            "type": "string",
            "description": "Metric this task produces (e.g., articulation_accuracy, sentence_length)"
          },
          "video_url": {
            "type": "string",
            "description": "URL to demonstration video"
          },
          "notes": {
            "type": "string",
            "description": "Additional instructions"
          }
        }
      }
    },
    "order": {
      "type": "integer",
      "description": "Order in the week (1-7)"
    }
  },
  "required": [
    "day_of_week",
    "workout_type",
    "exercises",
    "order"
  ]
}